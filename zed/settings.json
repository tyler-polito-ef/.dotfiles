// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run the `open default settings` command
// from the command palette or from `Zed` application menu.
{
  "disable_ai": true,
  "diff_view_style": "split",
  "file_finder": {
    "modal_max_width": "xlarge"
  },
  "use_system_window_tabs": false,
  "preview_tabs": {
    "enabled": true
  },
  "tab_bar": {
    "show_pinned_tabs_in_separate_row": true
  },
  "show_edit_predictions": false,
  "proxy": "",
  "agent_servers": {
    "pi-acp": {
      "default_config_options": {
        "model": "vercel-ai-gateway/zai/glm-5.2"
      },
      "type": "registry"
    },
    "claude-acp": {
      "default_config_options": {
        "mode": "auto",
        "model": "opus[1m]",
      },
      "type": "registry",
    },
  },
  "cli_default_open_behavior": "new_window",
  "project_panel": {
    "dock": "left",
  },
  "outline_panel": {
    "dock": "left",
  },
  "git_panel": {
    "dock": "left",
    "tree_view": true,
  },
  "edit_predictions": {
    "provider": "copilot",
    "mode": "subtle",
  },
  "agent": {
    "play_sound_when_agent_done": "when_hidden",
    "sidebar_side": "left",
    "dock": "left",
    "inline_assistant_model": {
      "provider": "copilot_chat",
      "model": "claude-sonnet-4.6",
    },
    "model_parameters": [],
    "default_model": {
      "provider": "copilot_chat",
      "model": "gpt-5.2-codex",
    },
  },
  "icon_theme": {
    "mode": "light",
    "light": "Bearded Icon Theme",
    "dark": "Bearded Icon Theme"
  },
  "ui_font_family": "JetBrainsMono Nerd Font Mono",
  "buffer_font_family": "JetBrainsMono Nerd Font Mono",
  "soft_wrap": "editor_width",
  "base_keymap": "VSCode",
  "theme": {
    "mode": "system",
    "light": "One Light",
    "dark": "Merino Dark"
  },
  "experimental.theme_overrides": {
    "editor.background": "#000000",
    "editor.gutter.background": "#000000",
    "editor.active_line.background": "#000000",
    "editor.highlighted_line.background": "#000000",
    "search.match_background": "#C9A8F940",
  },
  // "buffer_font_size": 18,
  // "ui_font_size": 18,
  "buffer_font_size": 16,
  "ui_font_size": 16,
  "vim_mode": true,
  "vim": {
    "highlight_on_yank_duration": 200,
  },
  "relative_line_numbers": "enabled",
  "file_types": {
    "CSS": ["scss"],
  },
  "indent_guides": {
    "enabled": true,
    "coloring": "indent_aware",
  },
  "inlay_hints": {
    "enabled": false,
  },
  "tabs": {
    "git_status": true,
    "file_icons": true,
  },
  "git": {
    "inline_blame": {
      "enabled": false,
    },
  },
  "collaboration_panel": {
    "dock": "left",
  },
  "agent_buffer_font_size": 16,
  "cursor_animation": {
    "enabled": true
  }
}
