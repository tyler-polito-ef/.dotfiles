{
  "$schema": "https://zed.dev/schema/themes/v0.2.0.json",
  "name": "Merino",
  "author": "Tyler Polito",
  "themes": [
    {
      "name": "Merino Dark",
      "appearance": "dark",
      "style": {
        "background.appearance": "opaque",
        "accents": ["#3485fa", "#bc8cff", "#39c5cf", "#3fb950", "#d29922", "#ff7b72"],

        "border": "#2e3135",
        "border.variant": "#202327",
        "border.focused": "#3485fa",
        "border.selected": "#3485fa",
        "border.transparent": "#00000000",
        "border.disabled": "#25282c",

        "elevated_surface.background": "#222427",
        "surface.background": "#131519",
        "background": "#0c0e11",

        "element.background": "#1e2023",
        "element.hover": "#e6edf30b",
        "element.active": "#e6edf31a",
        "element.selected": "#e6edf313",
        "element.disabled": "#1e2023",
        "drop_target.background": "#3485fa26",

        "ghost_element.background": "#00000000",
        "ghost_element.hover": "#e6edf30b",
        "ghost_element.active": "#e6edf31a",
        "ghost_element.selected": "#e6edf313",
        "ghost_element.disabled": "#00000000",

        "text": "#e6edf3",
        "text.muted": "#82878c",
        "text.placeholder": "#666a6f",
        "text.disabled": "#4a4e53",
        "text.accent": "#3485fa",

        "icon": "#b1bac4",
        "icon.muted": "#82878c",
        "icon.disabled": "#4a4e53",
        "icon.placeholder": "#666a6f",
        "icon.accent": "#3485fa",

        "status_bar.background": "#131519",
        "title_bar.background": "#131519",
        "title_bar.inactive_background": "#0f1114",
        "toolbar.background": "#0d1117",
        "tab_bar.background": "#131519",
        "tab.inactive_background": "#131519",
        "tab.active_background": "#0d1117",
        "search.match_background": "#3485fa40",
        "panel.background": "#0f1319",
        "panel.focused_border": "#3485fa",
        "panel.indent_guide": "#202327",
        "panel.indent_guide_active": "#2e3135",
        "panel.indent_guide_hover": "#424549",
        "pane.focused_border": "#3485fa",
        "pane_group.border": "#2e3135",

        "scrollbar.thumb.background": "#e6edf31a",
        "scrollbar.thumb.hover_background": "#e6edf333",
        "scrollbar.thumb.border": "#00000000",
        "scrollbar.track.background": "#00000000",
        "scrollbar.track.border": "#00000000",

        "editor.foreground": "#e6edf3",
        "editor.background": "#0d1117",
        "editor.gutter.background": "#0d1117",
        "editor.subheader.background": "#131519",
        "editor.active_line.background": "#e6edf308",
        "editor.highlighted_line.background": "#e6edf30b",
        "editor.line_number": "#484f58",
        "editor.active_line_number": "#e6edf3",
        "editor.invisible": "#2e3135",
        "editor.wrap_guide": "#202327",
        "editor.active_wrap_guide": "#2e3135",
        "editor.indent_guide": "#202327",
        "editor.indent_guide_active": "#2e3135",
        "editor.document_highlight.read_background": "#3485fa1f",
        "editor.document_highlight.write_background": "#3485fa33",
        "editor.document_highlight.bracket_background": "#3485fa26",

        "terminal.background": "#0d1117",
        "terminal.foreground": "#e6edf3",
        "terminal.bright_foreground": "#ffffff",
        "terminal.dim_foreground": "#82878c",
        "terminal.ansi.black": "#484f58",
        "terminal.ansi.red": "#ff7b72",
        "terminal.ansi.green": "#3fb950",
        "terminal.ansi.yellow": "#d29922",
        "terminal.ansi.blue": "#58a6ff",
        "terminal.ansi.magenta": "#bc8cff",
        "terminal.ansi.cyan": "#39c5cf",
        "terminal.ansi.white": "#b1bac4",
        "terminal.ansi.bright_black": "#6e7681",
        "terminal.ansi.bright_red": "#ffa198",
        "terminal.ansi.bright_green": "#56d364",
