        "terminal.ansi.bright_blue": "#79c0ff",
        "terminal.ansi.bright_magenta": "#d2a8ff",
        "terminal.ansi.bright_cyan": "#56d4dd",
        "terminal.ansi.bright_white": "#ffffff",
        "terminal.ansi.dim_black": "#32373e",
        "terminal.ansi.dim_red": "#b3564f",
        "terminal.ansi.dim_green": "#2c8238",
        "terminal.ansi.dim_yellow": "#936b18",
        "terminal.ansi.dim_blue": "#3e74b3",
        "terminal.ansi.dim_magenta": "#8462b3",
        "terminal.ansi.dim_cyan": "#288a91",
        "terminal.ansi.dim_white": "#7c8289",

