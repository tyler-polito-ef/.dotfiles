        "conflict.border": "#d2992266",
        "created": "#3fb950",
        "created.background": "#3fb9501a",
        "created.border": "#3fb95066",
        "deleted": "#ff7b72",
        "deleted.background": "#ff7b721a",
        "deleted.border": "#ff7b7266",
        "error": "#ff7b72",
        "error.background": "#ff7b721a",
        "error.border": "#ff7b7266",
        "hidden": "#666a6f",
        "hidden.background": "#666a6f1a",
        "hidden.border": "#2e3135",
        "hint": "#82878c",
        "hint.background": "#82878c1a",
        "hint.border": "#2e3135",
        "ignored": "#666a6f",
        "ignored.background": "#666a6f1a",
        "ignored.border": "#2e3135",
        "info": "#58a6ff",
        "info.background": "#58a6ff1a",
        "info.border": "#58a6ff66",
        "modified": "#d29922",
        "modified.background": "#d299221a",
        "modified.border": "#d2992266",
        "predictive": "#666a6f",
        "predictive.background": "#666a6f1a",
        "predictive.border": "#2e3135",
        "renamed": "#58a6ff",
        "renamed.background": "#58a6ff1a",
        "renamed.border": "#58a6ff66",
        "success": "#3fb950",
        "success.background": "#3fb9501a",
        "success.border": "#3fb95066",
        "unreachable": "#82878c",
        "unreachable.background": "#82878c1a",
        "unreachable.border": "#2e3135",
        "warning": "#d29922",
        "warning.background": "#d299221a",
        "warning.border": "#d2992266",

        "players": [
          { "cursor": "#2f81f7", "background": "#2f81f7", "selection": "#1b3a66" },
          { "cursor": "#bc8cff", "background": "#bc8cff", "selection": "#bc8cff3d" },
          { "cursor": "#3fb950", "background": "#3fb950", "selection": "#3fb9503d" },
          { "cursor": "#d29922", "background": "#d29922", "selection": "#d299223d" },
          { "cursor": "#39c5cf", "background": "#39c5cf", "selection": "#39c5cf3d" },
          { "cursor": "#ff7b72", "background": "#ff7b72", "selection": "#ff7b723d" }
        ],

        "syntax": {
          "attribute": { "color": "#79c0ff" },
          "boolean": { "color": "#79c0ff" },
          "comment": { "color": "#82878c", "font_style": "italic" },
          "comment.doc": { "color": "#82878c", "font_style": "italic" },
          "constant": { "color": "#79c0ff" },
          "constructor": { "color": "#d2a8ff" },
          "embedded": { "color": "#e6edf3" },
          "emphasis": { "color": "#e6edf3", "font_style": "italic" },
          "emphasis.strong": { "color": "#e6edf3", "font_weight": 700 },
          "enum": { "color": "#ffa657" },
          "function": { "color": "#d2a8ff" },
          "function.method": { "color": "#d2a8ff" },
          "function.builtin": { "color": "#79c0ff" },
          "hint": { "color": "#82878c" },
          "keyword": { "color": "#ff7b72" },
          "label": { "color": "#79c0ff" },
          "link_text": { "color": "#a5d6ff" },
          "link_uri": { "color": "#58a6ff" },
          "number": { "color": "#79c0ff" },
          "operator": { "color": "#ff7b72" },
          "predictive": { "color": "#666a6f", "font_style": "italic" },
          "preproc": { "color": "#ff7b72" },
          "primary": { "color": "#e6edf3" },
          "property": { "color": "#79c0ff" },
          "punctuation": { "color": "#b1bac4" },
          "punctuation.bracket": { "color": "#b1bac4" },
          "punctuation.delimiter": { "color": "#b1bac4" },
          "punctuation.list_marker": { "color": "#ffa657" },
          "punctuation.special": { "color": "#ff7b72" },
          "string": { "color": "#a5d6ff" },
          "string.escape": { "color": "#79c0ff" },
          "string.regex": { "color": "#7ee787" },
          "string.special": { "color": "#a5d6ff" },
          "string.special.symbol": { "color": "#79c0ff" },
          "tag": { "color": "#7ee787" },
          "text.literal": { "color": "#a5d6ff" },
          "title": { "color": "#58a6ff", "font_weight": 700 },
          "type": { "color": "#ffa657" },
          "type.builtin": { "color": "#ff7b72" },
          "variable": { "color": "#e6edf3" },
          "variable.special": { "color": "#79c0ff" },
          "variant": { "color": "#79c0ff" }
        }
